#!/bin/sh
set -eu

# Host-side recovery for self-hosted Mobius.
#
# The operator already has host and Docker root, so "recovery" is simply a root
# shell inside the LIVE app container: fix /data/platform (or anything else) in
# place, then restart in place. The app is never stopped or recreated, no
# isolated services or credentials are involved, and the container overlay and
# /data volume are preserved.
#
# When the container is up at all it boots the baked floor automatically if your
# platform edits are broken (see backend/scripts/entrypoint.sh), so the normal
# in-container agent is available to repair /data/platform from ordinary Mobius
# too — this shell is the direct, no-UI path to the same place.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(dirname "$SCRIPT_DIR")
# Pin the installation identity like deploy-prod.sh so a linked worktree's
# directory name never selects a different Compose project/container.
COMPOSE_PROJECT=${MOBIUS_COMPOSE_PROJECT:-mobius}

usage() {
  cat >&2 <<'EOF'
Usage: scripts/mobiusctl recovery

  recovery  Open a root shell in the running Mobius app container to repair it
            in place (edit /data/platform, read logs, adjust /data), then
            restart from Settings -> Server or `docker restart`. The app is
            never stopped or recreated; your container overlay is preserved.
EOF
  exit 64
}

case "${1:-}" in
  recovery) ;;
  *) usage ;;
esac

case "${2:-}" in
  "") ;;
  start | reopen | status | finish)
    cat >&2 <<EOF
'recovery $2' is retired: recovery no longer stops or recreates the container,
and there are no isolated services or one-time codes to manage.

Run 'scripts/mobiusctl recovery' to open a root shell in the live app instead,
fix things in place, then restart from Settings -> Server (or 'docker restart').
EOF
    exit 64
    ;;
  *) usage ;;
esac

compose() {
  (
    cd "$PROJECT_DIR"
    if [ -f .env ]; then
      docker compose -p "$COMPOSE_PROJECT" --env-file .env "$@"
    else
      docker compose -p "$COMPOSE_PROJECT" "$@"
    fi
  )
}

container_id=$(compose ps -q app 2>/dev/null || true)

if [ -n "$container_id" ]; then
  echo "Opening a root shell in the running Mobius container ($container_id)."
  echo "You are root in the LIVE app. Edit /data/platform to fix broken source,"
  echo "then restart in place (Settings -> Server, or: docker restart $container_id)."
  shell=sh
  if docker exec "$container_id" sh -c 'command -v bash >/dev/null 2>&1'; then
    shell=bash
  fi
  exec docker exec -u 0 -it "$container_id" "$shell"
fi

# Not running: it must be started before there is anything to attach to. Booting
# re-runs the entrypoint, which falls back to the baked floor when /data/platform
# is broken, so the normal in-container agent comes back to repair it.
cat >&2 <<EOF
The Mobius app container is not running, so there is nothing to attach to yet.
First try to start it (it boots the baked floor automatically if /data/platform
is broken, bringing the normal in-container agent back to repair it), then
re-run this command:

  cd "$PROJECT_DIR" && docker compose -p "$COMPOSE_PROJECT" up -d app
  scripts/mobiusctl recovery

If it will NOT stay up -- e.g. the baked fallback was removed too, so no boot
ever completes -- get a root shell on your data directly. This starts a
throwaway one-off container with the same image and your /data volume mounted,
and does NOT touch the app service, so it works even when nothing boots:

  cd "$PROJECT_DIR" && docker compose -p "$COMPOSE_PROJECT" run --rm -u 0 --entrypoint sh app

Fix /data/platform (or restore the baked floor) there, exit, then start the app
again. To inspect why it will not stay up:

  cd "$PROJECT_DIR" && docker compose -p "$COMPOSE_PROJECT" logs --tail=100 app
EOF
exit 1
