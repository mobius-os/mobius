#!/usr/bin/env bash
# Call the Möbius backend with the current agent's base URL and owner auth.
# Literal or multiline request bodies can be streamed unchanged with
# `--data-binary @-`; body-bearing calls receive application/json unless the
# caller supplies an explicit Content-Type.
set -euo pipefail
: "${AGENT_TOKEN:?mapi: AGENT_TOKEN is not set in this environment}"
: "${API_BASE_URL:?mapi: API_BASE_URL is not set in this environment}"

parse_option() {
  OPTION_VALUE_KIND=""
  OPTION_VALUE=""
  OPTION_VALUE_ATTACHED=false
  OPTION_TAKES_NEXT=false
  OPTION_UNSAFE=false
  OPTION_INVALID=false

  case "$1" in
    -K|--config|--config=*|-L|--location|--location-trusted|\
    -x|--proxy|--proxy=*|--preproxy|--preproxy=*|--proxy1.0|--proxy1.0=*|\
    --socks4|--socks4=*|--socks4a|--socks4a=*|--socks5|--socks5=*|\
    --socks5-hostname|--socks5-hostname=*|--connect-to|--connect-to=*|\
    --resolve|--resolve=*|--alt-svc|--alt-svc=*|\
    --unix-socket|--unix-socket=*|\
    --abstract-unix-socket|--abstract-unix-socket=*|\
    --request-target|--request-target=*)
      OPTION_UNSAFE=true
      return
      ;;
  esac

  case "$1" in
    -w|--write-out|--write-out=*) chooses_write_out=true ;;
  esac

  case "$1" in
    -X|--request) OPTION_VALUE_KIND=request; OPTION_TAKES_NEXT=true; return ;;
    --request=*)
      OPTION_VALUE_KIND=request; OPTION_VALUE="${1#*=}"
      OPTION_VALUE_ATTACHED=true; return ;;
    -H|--header) OPTION_VALUE_KIND=header; OPTION_TAKES_NEXT=true; return ;;
    --header=*)
      OPTION_VALUE_KIND=header; OPTION_VALUE="${1#*=}"
      OPTION_VALUE_ATTACHED=true; return ;;
    -d|--data|--data-ascii|--data-raw|--data-binary|--data-urlencode|--json)
      OPTION_VALUE_KIND=data; OPTION_TAKES_NEXT=true; return ;;
    --data=*|--data-ascii=*|--data-raw=*|--data-binary=*|\
    --data-urlencode=*|--json=*)
      OPTION_VALUE_KIND=data; OPTION_VALUE="${1#*=}"
      OPTION_VALUE_ATTACHED=true; return ;;
    --url-query)
      OPTION_VALUE_KIND=query; OPTION_TAKES_NEXT=true; return ;;
    --url-query=*)
      OPTION_VALUE_KIND=query; OPTION_VALUE="${1#*=}"
      OPTION_VALUE_ATTACHED=true; return ;;
    -F|--form|-T|--upload-file|-o|--output|-D|--dump-header|-w|--write-out|\
    -m|--max-time|-E|--cert|--connect-timeout|--retry|--retry-delay|\
    --cacert|--key)
      OPTION_VALUE_KIND=other; OPTION_TAKES_NEXT=true; return ;;
    --form=*|--upload-file=*|--output=*|--dump-header=*|--write-out=*|\
    --max-time=*|--cert=*|--connect-timeout=*|--retry=*|--retry-delay=*|\
    --cacert=*|--key=*)
      OPTION_VALUE_KIND=other; OPTION_VALUE="${1#*=}"
      OPTION_VALUE_ATTACHED=true; return ;;
    --fail|--fail-with-body|--silent|--show-error|--include|--head|--get|\
    --no-buffer|--compressed|--globoff)
      case "$1" in
        --get) uses_get=true ;;
        --fail|--fail-with-body) chooses_fail=true ;;
      esac
      return ;;
    --*)
      OPTION_INVALID=true
      return
      ;;
  esac

  [[ "$1" == -?* && "$1" != --* ]] || return 0
  local options="${1#-}"
  local index option
  for ((index = 0; index < ${#options}; index++)); do
    option="${options:index:1}"
    case "$option" in
      K|L|x)
        OPTION_UNSAFE=true
        return
        ;;
      X) OPTION_VALUE_KIND=request ;;
      H) OPTION_VALUE_KIND=header ;;
      d) OPTION_VALUE_KIND=data ;;
      w) OPTION_VALUE_KIND=other; chooses_write_out=true ;;
      F|T|o|D|m|E) OPTION_VALUE_KIND=other ;;
      # Boolean short flags used by the documented mapi recipes.  Unknown
      # flags must fail closed: curl's short-option grammar lets an earlier
      # value-taking flag consume the remainder, so skipping a character can
      # make mapi and curl disagree about whether the next argv is a URL.
      G) uses_get=true; continue ;;
      f) chooses_fail=true; continue ;;
      s|S|g|i|I|N|v) continue ;;
      *) OPTION_INVALID=true; return ;;
    esac
    OPTION_VALUE="${options:index+1}"
    if [[ -z "$OPTION_VALUE" ]]; then
      OPTION_TAKES_NEXT=true
    fi
    return 0
  done
  return 0
}

note_option_value() {
  local kind="$1"
  local value="$2"
  case "$kind" in
    request)
      if [[ ! "$value" =~ ^[A-Za-z]+$ ]]; then
        printf '%s\n' \
          "mapi: request method must contain only HTTP token letters" >&2
        exit 2
      fi
      ;;
    data)
      has_body=true
      ;;
    header)
      local lower_value="${value,,}"
      local header_name="${lower_value%%[:;]*}"
      if [[ "$value" == @* || "$value" == *$'\r'* || "$value" == *$'\n'* \
         || "$header_name" == host || "$lower_value" == :authority:* \
         || "$lower_value" == :authority\;* ]]; then
        printf '%s\n' \
          "mapi: refusing an opaque or Host-replacing header with owner auth" >&2
        exit 2
      fi
      [[ "$lower_value" == content-type:* ]] && has_content_type=true
      ;;
  esac
  return 0
}

resolved=()
has_body=false
has_content_type=false
has_api_target=false
uses_get=false
chooses_fail=false
chooses_write_out=false
pending_value_kind=""
pending_option=""
for argument in "$@"; do
  if [[ -n "$pending_value_kind" ]]; then
    note_option_value "$pending_value_kind" "$argument"
    resolved+=("$argument")
    pending_value_kind=""
    pending_option=""
    continue
  fi

  if [[ "$argument" == /api/* || "$argument" == /api ]]; then
    api_path="${argument%%\?*}"
    api_path="${api_path%%\#*}"
    lower_api_path="${api_path,,}"
    case "/${api_path#/}/" in
      */./*|*/../*)
        printf '%s\n' "mapi: target path must stay within /api" >&2
        exit 2
        ;;
    esac
    if [[ "$lower_api_path" == *%2e* || "$lower_api_path" == *%2f* \
       || "$lower_api_path" == *%5c* || "$api_path" == *\\* ]]; then
      printf '%s\n' \
        "mapi: encoded separators or dot segments are not valid API targets" >&2
      exit 2
    fi
    has_api_target=true
    argument="${API_BASE_URL%/}$argument"
  elif [[ "$argument" == http://* || "$argument" == https://* \
       || "$argument" == --url || "$argument" == --url=* ]]; then
    printf '%s\n' \
      "mapi: targets must be Möbius /api paths; refusing to forward owner auth" >&2
    exit 2
  elif [[ "$argument" != -* ]]; then
    printf '%s\n' \
      "mapi: unexpected target '$argument'; only Möbius /api paths are allowed" >&2
    exit 2
  else
    parse_option "$argument"
    if $OPTION_INVALID; then
      printf '%s\n' \
        "mapi: unsupported curl option '$argument'" >&2
      exit 2
    fi
    if $OPTION_UNSAFE; then
      printf '%s\n' \
        "mapi: curl option '$argument' can change the authenticated request target" >&2
      exit 2
    fi
    if $OPTION_VALUE_ATTACHED; then
      note_option_value "$OPTION_VALUE_KIND" "$OPTION_VALUE"
      # curl only gained `--long=value` parsing in 8.16, while supported
      # deployments can still ship older versions. The separated spelling has
      # the same meaning on every supported curl and keeps mapi's surface stable.
      resolved+=("${argument%%=*}" "$OPTION_VALUE")
      continue
    elif [[ -n "$OPTION_VALUE_KIND" && -n "$OPTION_VALUE" ]]; then
      note_option_value "$OPTION_VALUE_KIND" "$OPTION_VALUE"
    elif $OPTION_TAKES_NEXT; then
      pending_value_kind="$OPTION_VALUE_KIND"
      pending_option="$argument"
    fi
  fi
  resolved+=("$argument")
done

if [[ -n "$pending_value_kind" ]]; then
  printf '%s\n' "mapi: curl option '$pending_option' needs a value" >&2
  exit 2
fi

if ! $has_api_target; then
  printf '%s\n' "mapi: expected a Möbius /api target" >&2
  exit 2
fi

# -q must be curl's first argument to disable implicit ~/.curlrc loading. A
# config file can add arbitrary URLs, which would bypass mapi's target check.
# --globoff keeps curl from expanding one validated /api target into additional
# normalized requests after mapi has finished checking it.
curl_args=(-q --globoff -sS -H "Authorization: Bearer $AGENT_TOKEN")
if $has_body && ! $uses_get && ! $has_content_type; then
  curl_args+=(-H "Content-Type: application/json")
fi
# An HTTP error must not look like success: exit non-zero (curl's 22) while
# still printing the response body that explains it. curl refuses --fail and
# --fail-with-body together, so an explicit caller choice wins.
if ! $chooses_fail; then
  curl_args+=(--fail-with-body)
fi
if $chooses_write_out; then
  exec curl "${curl_args[@]}" "${resolved[@]}"
fi

# A successful empty reply (often 204 after a write) would otherwise print
# nothing at all. curl reports the status on stderr through a marker line that
# this filter turns into one short note; stdout still streams untouched.
status_marker="mapi-status:"
note_empty_success() {
  local line exit_code http_code size
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$status_marker"* ]]; then
      read -r exit_code http_code size <<< "${line#"$status_marker"}"
      if [[ "$exit_code" == 0 && "$http_code" == 2?? && "$size" == 0 ]]; then
        printf 'mapi: HTTP %s, empty response (success)\n' "$http_code"
      fi
    else
      printf '%s\n' "$line"
    fi
  done
}
curl_args+=(
  -w "%{stderr}${status_marker}%{exitcode} %{http_code} %{size_download}\n"
)
# curl's stdout goes straight to the caller (fd 3); only its stderr is piped.
set +e
{
  curl "${curl_args[@]}" "${resolved[@]}" 2>&1 >&3 3>&- \
    | note_empty_success >&2
  curl_status="${PIPESTATUS[0]}"
} 3>&1
exit "$curl_status"
