#!/usr/bin/env bash
# pm-commit: create a commit owned by declared paths, without sweeping /data.
#
# Usage:
#   START_SHA="$(git -C /data rev-parse HEAD)"   # capture before editing
#   pm-commit --from "$START_SHA" "message" -- path [path ...]

set -euo pipefail
# Fix the helper's own path before leaving the caller's directory: the
# owner re-run below must find this same helper when root named it relatively.
case "$0" in /*) SELF="$0" ;; *) SELF="$PWD/$0" ;; esac
cd "${PM_COMMIT_ROOT:-/data}"

# A plain root shell, such as a Recovery session, cannot commit here: Git
# refuses a repository owned by another user ("dubious ownership"), and
# trusting it as root would leave root-owned objects that break the owner's
# later commits. Commit as the repository's owner instead.
# Pass the resolved root on, so a relative one is not resolved a second time.
if [ "$(id -u)" -eq 0 ] && [ "$(stat -c %u .)" -ne 0 ]; then
  exec env PM_COMMIT_ROOT="$PWD" runuser -u "$(stat -c %U .)" -- "$SELF" "$@"
fi

DENY='^(agent-browser-profiles|compiled|logs|cron-logs|push|generated)(/|$)'

usage() {
  cat >&2 <<'EOF'
Usage:
  pm-commit --from <starting-sha> "message" -- <path> [path ...]
EOF
  exit 2
}

[ "${1:-}" = "--from" ] || usage
START="${2:-}"
shift 2
MESSAGE="${1:-}"
[ -n "$MESSAGE" ] || usage
shift
[ "${1:-}" = "--" ] || usage
shift
[ "$#" -gt 0 ] || usage
PATHS=("$@")

git rev-parse --verify "${START}^{commit}" >/dev/null 2>&1 || {
  echo "pm-commit: starting revision is not a commit: $START" >&2
  exit 2
}
git merge-base --is-ancestor "$START" HEAD || {
  echo "pm-commit: history no longer descends from starting revision $START" >&2
  exit 3
}

for path in "${PATHS[@]}"; do
  case "$path" in
    ""|/*|../*|*/../*|*/..|-*)
      echo "pm-commit: path must be repository-relative: $path" >&2
      exit 2 ;;
  esac
  if [[ "$path" =~ $DENY ]]; then
    echo "pm-commit: runtime path may not be committed: $path" >&2
    exit 2
  fi
done

if ! git diff --quiet "$START"..HEAD -- "${PATHS[@]}"; then
  echo "pm-commit: a declared path changed since task start; reconcile it first" >&2
  git diff --stat "$START"..HEAD -- "${PATHS[@]}" >&2
  exit 3
fi
if ! git diff --cached --quiet -- "${PATHS[@]}"; then
  echo "pm-commit: a declared path is already staged; preserve or unstage it first" >&2
  exit 3
fi

STATUS="$(git status --porcelain=v1 --untracked-files=all -- "${PATHS[@]}")"
[ -n "$STATUS" ] || exit 0

# Backend commits are the last durable point before an agent can offer a
# planned restart.  Run the exact restart/boot import verdict here as well as
# at dispatch, so a dangling route reference is rejected while the change is
# still being authored instead of becoming a recovery-mode surprise later.
NEEDS_RESTART_PREFLIGHT=0
for path in "${PATHS[@]}"; do
  case "$path" in
    backend/app|backend/app/*) NEEDS_RESTART_PREFLIGHT=1 ;;
  esac
done
if [ "$NEEDS_RESTART_PREFLIGHT" -eq 1 ]; then
  PREFLIGHT="${PM_COMMIT_RESTART_PREFLIGHT:-backend/scripts/preflight-restart-source}"
  if [ ! -x "$PREFLIGHT" ]; then
    echo "pm-commit: restart preflight is missing or not executable: $PREFLIGHT" >&2
    exit 3
  fi
  if ! "$PREFLIGHT"; then
    echo "pm-commit: backend source failed the restart startup preflight; commit refused" >&2
    exit 3
  fi
fi

# Intent-to-add lets `git commit --only` include new files while that commit
# ignores every unrelated staged or unstaged change. On failure, restore only
# the paths this command introduced to the index.
git add -N -- "${PATHS[@]}"
cleanup_index() { git reset HEAD -- "${PATHS[@]}" >/dev/null 2>&1 || true; }
trap cleanup_index EXIT
git commit --only -m "$MESSAGE" -- "${PATHS[@]}"
trap - EXIT
